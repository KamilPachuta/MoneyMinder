@page "/CurrencyAccount/{name}"
@using MoneyMinderContracts.Requests.CurrencyAccounts
@using MoneyMinderContracts.Responses.CurrencyAccounts
@inject ICurrencyAccountService CurrencyService
@inject NavMenuState NavState
@inherits BasePage
    
<MudGrid>
    <MudItem xs="12" sm="4">
        <MudPaper Elevation="1" Class="px-4 py-4" Height="100%">
            <MudText Typo="Typo.h3" Class="px-2 py-2">@Name</MudText>
            @Balances
            @NoBalances
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="7">
        <MudPaper Elevation="1" Class="px-4 py-4" Height="100%">
            <MudStack>
                <MudFab Label="Add Transaction" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTransactionDialog" Size="Size.Small"/>
                <MudFab Label="Currency Exchange" StartIcon="@Icons.Material.Filled.CurrencyExchange" OnClick="ConvertCurrency" Size="Size.Small"/>
                <MudFab Label="Edit Currency Account Name" StartIcon="@Icons.Material.Filled.EditNote" OnClick="EditCurrencyAccountName" Size="Size.Small"/>
                <MudFab Label="Budget" StartIcon="@Icons.Material.Filled.BarChart" OnClick="Budget" Size="Size.Small"/>
                <MudFab Label="Remove Currency Account" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="DeleteCurrencyAccount" Size="Size.Small"/>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        @TransactionsTable
    </MudItem>
</MudGrid>

@code {
    [Parameter] 
    public string Name { get; set; }
    [CascadingParameter]
    public Guid CurrencyAccountId { get; set; }
    [CascadingParameter]
    public DateTime CurrencyAccountCreatedAt { get; set; }
    
    private bool _succeded = false;
    private DialogParameters _parameters = new DialogParameters();
    private DialogParameters _fullParameters = new DialogParameters();

    private List<string> _errors;
    private GetCurrencyAccountNamesResponse _response;
    private List<BalanceDto> _balances = new();

    private bool show = false;
    private MudTable<CurrencyTransactionDetailsDto> mudTable;
    private int selectedRowNumber = -1;
    private CurrencyTransactionDetailsDto? selectedModel = null;
    private List<CurrencyTransactionDetailsDto> _transactions = new();

    private RemoveIncomeRequest _incomeRequest;
    private RemovePaymentRequest _paymentRequest;



    private async Task ConvertCurrency()
        => await ShowDialogAsync<ConvertCurrencyDialog>("Convert Currency", _parameters);
    
    private async Task EditCurrencyAccountName()
        => await ShowDialogAsync<EditCurrencyAccountNameDialog>("Edit Currency Account", _parameters);
    
    private async Task Budget()
    {
        NavigationManager.NavigateTo(PathBuilder.BudgetPath(Name));
    }

    private async Task DeleteCurrencyAccount()
    {
        await ShowDialogAsync<DeleteCurrencyAccountDialog>("Delete Currency Account", _parameters);
        await NavState.RefreshCurrencyAsync();
        NavigationManager.NavigateTo(PathBuilder.HomePath());
    }

    protected override async Task OnParametersSetAsync()
    {
        await SetParams();
    }

    private async Task AddTransactionDialog()
        => await ShowDialogAsync<AddCurrencyTransactionDialog>("Add Transaction", _fullParameters);

    private async Task RemoveTransactionDialog()
    {
        if(selectedModel is null)
            return;
        
        _parameters.Add("TransactionDto", selectedModel);
        
        await ShowDialogAsync<RemoveCurrencyTransactionDialog>("Remove Transaction", _parameters);
    }
    private async Task LoadCurrencyAccountMetadata()
    {
        var metadataResult = await CurrencyService.GetCurrencyAccountMetadataByNameAsync(Name);
        if (!metadataResult.Succeeded)
        {
            _succeded = false;
            _errors = metadataResult.ErrorList;
            return;
        }

        CurrencyAccountId = metadataResult.Response.Id;
        
        CurrencyAccountCreatedAt = metadataResult.Response.CreatedAt;
    }
    private async Task LoadCurrencyAccountBalances()
    {
        var balancesResult = await CurrencyService.GetCurrencyAccountBalancesAsync(CurrencyAccountId);

        if (!balancesResult.Succeeded)
        {
            _succeded = false;
            _errors = balancesResult.ErrorList;
            return;
        }

        _balances = balancesResult.Response.Balances.ToList();
    }

    private async Task LoadCurrencyAccountTransactions()
    {
        var transactionsResult = await CurrencyService.GetCurrencyAccountTransactionsAsync(CurrencyAccountId);
        
        if (!transactionsResult.Succeeded)
        {
            _succeded = false;
            _errors = transactionsResult.ErrorList;
            return;
        }

        _transactions= transactionsResult.Response.Transactions.ToList();
    }

    protected override async Task RefreshDataAsync()
    {
        await LoadCurrencyAccountMetadata();
        await LoadCurrencyAccountBalances();
        await LoadCurrencyAccountTransactions();
    }

    private async Task SetParams()
    {
        await RefreshDataAsync();
        
        _parameters = new DialogParameters()
        {
            { "CurrencyAccountId", CurrencyAccountId }
        };
        
        _fullParameters = new DialogParameters()
        {
            { "CurrencyAccountId", CurrencyAccountId },
            { "CurrencyAccountCreatedAt", CurrencyAccountCreatedAt}
        };
        
        _succeded = true;
    }
    
    private string SelectedRowClassFunc(CurrencyTransactionDetailsDto transaction, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        
        if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(transaction))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        
        return string.Empty;
        
    }
    
    private void RowClickEvent(TableRowClickEventArgs<CurrencyTransactionDetailsDto> args)
    {
        if (selectedModel == args.Item)
        {
            selectedModel = null;
            show = false;
            StateHasChanged();
            return;
        }

        selectedModel = args.Item;
        show = selectedModel.Category is not null;
        StateHasChanged();
    }

    #region Renders

    RenderFragment TransactionsTable => _transactions.Any()
        ? @<MudPaper>
              <MudTooltip Text="Add transaction">
                  <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddTransactionDialog"></MudIconButton>
              </MudTooltip>
              <MudTooltip Text="Remove transaction">
                  <MudIconButton Icon="@Icons.Material.Filled.Remove" OnClick="RemoveTransactionDialog"></MudIconButton>
              </MudTooltip>
              <MudPaper Elevation="2" Class="align-start d-flex">
                  <MudGrid>
                      <MudItem xs="12" md="5">
                          <MudContainer Style="max-height: 600px;">
                              <MudList T="string">
                                  <MudListSubheader>
                                      <MudText Typo="Typo.h5">Transaction Details</MudText>
                                  </MudListSubheader>
                                  <MudListItem>
                                      <MudText>Transaction name: @selectedModel?.Name</MudText>
                                  </MudListItem>
                                  <MudListItem>
                                      <MudText>Transaction date: @selectedModel?.Date.ToString("dd-MM-yyyy")</MudText>

                                  </MudListItem>
                                  @if (show && selectedModel is not null && selectedModel.Category is not null)
                                  {

                                      <MudListItem>
                                          <MudText>Category: @selectedModel?.Category</MudText>
                                      </MudListItem>
                                  }
                                  <MudListItem>
                                      <MudText>Amount: @selectedModel?.Amount @selectedModel?.Currency</MudText>
                                  </MudListItem>
                              </MudList>
                          </MudContainer>
                      </MudItem>
                      <MudItem xs="12" md="7">
                          <MudContainer Style="max-height: 450px; overflow-y: scroll;">

                              <MudTable Dense="true" T="CurrencyTransactionDetailsDto" Items="@_transactions" Hover="true" Breakpoint="Breakpoint.Sm" @ref="mudTable"
                                        RowClass="cursor-pointer" OnRowClick="RowClickEvent" RowClassFunc="@SelectedRowClassFunc" Class="d-inline">
                                  <HeaderContent>
                                      <MudTh>Amount</MudTh>
                                      <MudTh>Currency</MudTh>
                                      <MudTh>Date</MudTh>
                                  </HeaderContent>
                                  <RowTemplate>
                                      <MudTd DataLabel="Amount">@context.Amount</MudTd>
                                      <MudTd DataLabel="Currency">@context.Currency</MudTd>
                                      <MudTd DataLabel="Date">@context.Date.ToString("dd-MM-yyyy")</MudTd>
                                  </RowTemplate>
                              </MudTable>
                          </MudContainer>
                      </MudItem>
                  </MudGrid>

              </MudPaper>
          </MudPaper>
        : null;



    RenderFragment Balances => _balances.Any()
        ? @<MudPaper Class="p-2">
              <MudText Typo="Typo.h5" Class="px-2 py-2">Available funds</MudText>
              <MudStack>
                  @foreach (var balance in _balances)
                  {
                      <MudStack Row="true" AlignItems="AlignItems.Center">
                          <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"/>
                          <MudText>@($"{balance.Amount} {balance.Currency}")</MudText>
                      </MudStack>
                  }
              </MudStack>
          </MudPaper>
        : null;
    
    RenderFragment NoBalances => !_balances.Any()
        ? @<MudText Typo="Typo.h6" Class="px-2 py-2">No funds available yet. Add funds to get started.</MudText>
        : null;
    #endregion
    
}