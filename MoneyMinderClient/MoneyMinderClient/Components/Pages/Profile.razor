@page "/Profile"
@using MoneyMinderContracts.Responses.Accounts
@inject IAccountService AccountService
@inherits MoneyMinderClient.Core.BasePage

<PageTitle>Profile</PageTitle>

            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h4">Personal Information's</MudText>
                </MudCardHeader>
                <MudCardContent>
                    @if (_succeded)
                    {
                        @InfoRender
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditPassword">Change Password</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditName">Change Name</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditPhoneNumber">Change Phone Number</MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAddress">Change Address</MudButton>
                </MudCardActions>
            </MudCard>


@code {
    private bool _succeded = false;
    private List<string> _errors;

    private GetUserDetailsResponse _userDetails;

    private async Task EditName()
        => await ShowDialogAsync<EditUserNameDialog>("Edit User Name"); 
    


    private async Task EditPassword()
        => await ShowDialogAsync<EditPasswordDialog>("Edit Password");
    
    private async Task EditPhoneNumber()
        => await ShowDialogAsync<EditPhoneNumberDialog>("Edit Phone Number");
    
    private async Task EditAddress()
        => await ShowDialogAsync<EditAddressDialog>("Edit Address");
    
    
    private async Task SetParams()
    {
        var firstResult = await AccountService.GetUserDetailsAsync();
        if (!firstResult.Succeeded)
        {
            _succeded = false;
            _errors = firstResult.ErrorList;
            return;
        }

        _userDetails = firstResult.Response;

        _succeded = true;
    }
    
    protected async override Task OnParametersSetAsync()
    {
        await SetParams();
    }

    
    
    RenderFragment InfoRender => _succeded
        ? @<MudPaper MaxWidth="500px" Class="p-2 justify-start" Elevation="0">
                <MudGrid Spacing="2">
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Email:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.Email</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Name:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.Name</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Phone Number:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.PhoneNumber</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Birth Date:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.BirthDate.ToString("dd MMMM yyyy")</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Gender:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.Gender</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Country:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.Country</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">City:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.City</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Postal Code:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.PostalCode</MudText>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText Typo="Typo.subtitle1">Street:</MudText>
                    </MudItem>
                    <MudItem xs="8">
                        <MudText Typo="Typo.h6">@_userDetails.Street</MudText>
                    </MudItem>
                </MudGrid>
          </MudPaper>
        : null;

}