@page "/Reports"
@using FluentValidation
@using MoneyMinderContracts.Requests.CurrencyAccounts
@using MoneyMinderContracts.Requests.SavingsAccounts
@using MoneyMinderContracts.Responses.CurrencyAccounts
@using MoneyMinderContracts.Responses.SavingsAccounts
@using Severity = MudBlazor.Severity
@inject ICurrencyAccountService CurrencyService
@inject ISavingsAccountService SavingsService
@inherits BasePage



@ParamsContent
@PaymentsReportContent
@BalancesReportContent
@SavingsReportContent
@ReturnButton

@if(_noData && _reportCreated) 
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Elevation="0">
        No data for the selected filters.
    </MudAlert>
}
@if(!_reportRequestSucceded && _reportCreated) 
{ 
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Elevation="0">
        Report error.
    </MudAlert> 
}


    


@code {
    private AxisChartOptions _axisChartOptions = new AxisChartOptions() { XAxisLabelRotation = 45, MatchBoundsToSize = true};

     
    MudForm currencyForm;

    private ReportParams _reportParams = new();
    private ReportParamsValidator _reportParamsValidator;
    private ReportType _type = ReportType.PaymentsReport;
    private bool _setParamsSucceeded = false;
    private DateTime _earliestCurrencyCreatedAt;
    
    private GetCurrencyAccountsMetadataResponse _currencyAccountsMetadata;
    private GetSavingsAccountsMetadataResponse _savingsAccountsMetadata;
    
    private PostPaymentsReportRequest _paymentsReportRequest = new();
    private PostAllTimePaymentsReportRequest _allTimePaymentsReportRequest = new();

    private PostBalanceReportRequest _balanceReportRequest = new();
    private PostAllTimeBalanceReportRequest _allTimeBalanceReportRequest = new();

    private PostSavingsReportRequest _savingsReportRequest = new();
    private PostAllTimeSavingsReportRequest _allTimeSavingsReportRequest = new();
    
    private List<CurrencyPaymentDto> _payments = new();
    private List<CurrencyTransactionDto> _currencyTransactions = new();
    private List<SavingsTransactionDto> _savingsTransactions = new();
    
    private bool _noData = true;
    private bool _reportRequestSucceded = false;
    private bool _reportCreated = false;


    private List<CurrencySummary> _summaries = new();

    private record CurrencySummary(CurrencyDto currency, int Count, decimal Total);

    private Dictionary<CurrencyDto, ChartData> _charts = new();

    private int _totalCount;
    private string _dateRangeText = string.Empty;

  

    private record ChartData(string[] Labels, List<ChartSeries> Series);

    protected override async Task OnParametersSetAsync()
    {
        await SetParams();
    }

    private async Task GetReport()
    {
        await currencyForm.Validate();

        if (currencyForm.IsValid)
        {
            await (_type switch
            {
                ReportType.PaymentsReport => PaymentsReport(),
                ReportType.BalancesReport => BalanceReport(),
                ReportType.SavingsReport => SavingsReport(),
                _ => Task.CompletedTask
            });
        }

        _reportCreated = true;
        
    }

    private async Task Return()
    {
        _noData = true;
        _reportRequestSucceded = false;
        _reportCreated = false;
        _totalCount = 0;
        _summaries = null;
        _dateRangeText = "";
    }
    
    private async Task SetParams()
    {
        var currencyResponse = await CurrencyService.GetCurrencyAccountsMetadataAsync();
        
        if (!currencyResponse.Succeeded)
        {
            _setParamsSucceeded = false;
            SetErrors(currencyResponse.ErrorList);
            return;
        }

        _currencyAccountsMetadata = currencyResponse.Response;
        
        var savingsResponse = await SavingsService.GetSavingsAccountsMetadataAsync();
        
        if (!savingsResponse.Succeeded)
        {
            _setParamsSucceeded = false;
            SetErrors(savingsResponse.ErrorList);
            return;
        }

        _savingsAccountsMetadata = savingsResponse.Response;
        
        _reportParamsValidator = new(() => _earliestCurrencyCreatedAt);
        
        _setParamsSucceeded = true;
    }
    
    
    #region PaymentsReport
    
    private async Task PaymentsReport()
    {
        Result<GetCurrencyAccountReportPaymentsResponse> result;
        
        if (_reportParams.AllTime)
        {
            _allTimePaymentsReportRequest.CurrencyAccountIds = _currencyAccountsMetadata.CurrencyAccountMetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);

            _allTimePaymentsReportRequest.Currencies = _reportParams.Currencies
                .Select(x => Enum.Parse<CurrencyDto>(x))
                .ToList();
            result = await CurrencyService.PostAllTimePaymentsReportAsync(_allTimePaymentsReportRequest);
        }
        else
        {
            _paymentsReportRequest.CurrencyAccountIds = _currencyAccountsMetadata.CurrencyAccountMetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);

            _paymentsReportRequest.From = DateTime.SpecifyKind(_reportParams.From.Value, DateTimeKind.Utc);
            _paymentsReportRequest.To = DateTime.SpecifyKind(_reportParams.To.Value, DateTimeKind.Utc);
                
            _paymentsReportRequest.Currencies = _reportParams.Currencies
                .Select(x => Enum.Parse<CurrencyDto>(x))
                .ToList();
            result = await CurrencyService.PostPaymentsReportAsync(_paymentsReportRequest);
        }
        
        if (!result.Succeeded)
        {
            SetErrors(result.ErrorList);
            return;
        }
            
        _payments = result.Response.Payments
            .OrderBy(t => t.Date)
            .ToList();

        _reportRequestSucceded = true;
            
        await BuildPaymentsReportView();
    }
    
    private async Task BuildPaymentsReportView()
    {
        if (!_payments.Any())
        {
            _noData = true;
            return;
        }
        
        _noData = false;
        
        _totalCount = _payments.Count();
        
        _summaries = _payments
            .GroupBy(p => p.Currency)
            .Select(g => new CurrencySummary(g.Key, g.Count(), g.Sum(x => Math.Abs(x.Amount))))
            .ToList();
            
        var minDate = _payments.Min(p => p.Date);
        var maxDate = _payments.Max(p => p.Date);
        _dateRangeText = $"{minDate:dd.MM.yyyy} – {maxDate:dd.MM.yyyy}";

        _charts = _payments
            .GroupBy(p => p.Currency)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    var points = g.GroupBy(p => p.Date.Date)
                        .OrderBy(x => x.Key)
                        .Select(x => new
                        {
                            Date = x.Key,
                            Label = x.Key.ToString("dd.MM"),
                            DailyTotal = (double)x.Sum(p => Math.Abs(p.Amount))
                        })
                        .ToList();

                    double runningTotal = 0;
                    var cumulativePoints = points.Select(p =>
                    {
                        runningTotal += p.DailyTotal;
                        return new
                        {
                            p.Label,
                            Total = runningTotal
                        };
                    }).ToList();

                    var labels = cumulativePoints.Select(p => p.Label).ToArray();
                    var data = cumulativePoints.Select(p => p.Total).ToArray();

                    return new ChartData(labels, new List<ChartSeries>
                    {
                        new ChartSeries
                        {
                            Name = g.Key.ToString(),
                            Data = data
                        }
                    });
                });
    }
    
    
    #endregion
    
    #region BalancesReport
    
    private async Task BalanceReport()
    {
        Result<GetCurrencyAccountBalanceReportResponse> result;
        
        if (_reportParams.AllTime)
        {
            _allTimeBalanceReportRequest.CurrencyAccountIds = _currencyAccountsMetadata.CurrencyAccountMetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);
                    
            _allTimeBalanceReportRequest.Currencies = _reportParams.Currencies
                .Select(x => Enum.Parse<CurrencyDto>(x))
                .ToList();
                    
            result = await CurrencyService.PostAllTimeBalanceReportAsync(_allTimeBalanceReportRequest);
        }
        else
        {
            _balanceReportRequest.CurrencyAccountIds = _currencyAccountsMetadata.CurrencyAccountMetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);

            _balanceReportRequest.From = DateTime.SpecifyKind(_reportParams.From.Value, DateTimeKind.Utc);
            _balanceReportRequest.To = DateTime.SpecifyKind(_reportParams.To.Value, DateTimeKind.Utc);
                
            _balanceReportRequest.Currencies = _reportParams.Currencies
                .Select(x => Enum.Parse<CurrencyDto>(x))
                .ToList();
                    
            result = await CurrencyService.PostBalanceReportAsync(_balanceReportRequest);
        }
        
        if (!result.Succeeded)
        {
            SetErrors(result.ErrorList);
            return;
        }

        _currencyTransactions = result.Response.Transactions
            .OrderBy(t => t.Date)
            .ToList();
        
        _reportRequestSucceded = true;

        await BuildBalancesReportView();
    }

    private async Task BuildBalancesReportView()
    {
        if (!_currencyTransactions.Any())
        {
            _noData = true;
            return;
        }

        _noData = false;
        _totalCount = _currencyTransactions.Count;

        _summaries = _currencyTransactions
            .GroupBy(t => t.Currency)
            .Select(g => new CurrencySummary(
                g.Key,
                g.Count(),
                g.Sum(x => x.Amount)
            ))
            .ToList();

        var minDate = _currencyTransactions.Min(t => t.Date);
        var maxDate = _currencyTransactions.Max(t => t.Date);
        _dateRangeText = $"{minDate:dd.MM.yyyy} – {maxDate:dd.MM.yyyy}";

        _charts = _currencyTransactions
            .GroupBy(t => t.Currency)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    var points = g.GroupBy(t => t.Date.Date)
                        .OrderBy(x => x.Key)
                        .Select(x => new
                        {
                            Date = x.Key,
                            Label = x.Key.ToString("dd.MM"),
                            DailyTotal = (double)x.Sum(t => t.Amount)
                        })
                        .ToList();
        
                    double runningTotal = 0;
                    var cumulativePoints = points.Select(p =>
                    {
                        runningTotal += p.DailyTotal;
                        return new
                        {
                            p.Label,
                            Total = runningTotal
                        };
                    }).ToList();
        
                    var labels = cumulativePoints.Select(p => p.Label).ToArray();
                    var data = cumulativePoints.Select(p => p.Total).ToArray();
        
                    return new ChartData(labels, new List<ChartSeries>
                    {
                        new ChartSeries
                        {
                            Name = g.Key.ToString(),
                            Data = data
                        }
                    });
                });
    }
    

    #endregion
    
    #region SavingsReport
    
    private async Task SavingsReport()
    {
        Result<GetSavingsReportResponse> result;
        
        if (_reportParams.AllTime)
        {
            _allTimeSavingsReportRequest.SavingsAccountIds = _savingsAccountsMetadata.MetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);

            result = await SavingsService.PostAllTimeSavingsReportAsync(_allTimeSavingsReportRequest);
        }
        else
        {
            _savingsReportRequest.SavingsAccountIds = _savingsAccountsMetadata.MetadataDtos
                .Where(m => _reportParams.Names.Contains(m.Name))
                .Select(m => m.Id);

            _savingsReportRequest.From = DateTime.SpecifyKind(_reportParams.From.Value, DateTimeKind.Utc);
            _savingsReportRequest.To = DateTime.SpecifyKind(_reportParams.To.Value, DateTimeKind.Utc);

            result = await SavingsService.PostSavingsReportAsync(_savingsReportRequest);
        }
        
        if (!result.Succeeded)
        {
            SetErrors(result.ErrorList);
            return;
        }
            
        _savingsTransactions = result.Response.Transactions
            .OrderBy(t => t.Date)
            .ToList();
        
        _reportRequestSucceded = true;
        
        await BuildSavingsReportView();
    }

    private async Task BuildSavingsReportView()
    {
        if (!_savingsTransactions.Any())
        {
            _noData = true;
            return;
        }

        _noData = false;
        _totalCount = _savingsTransactions.Count;

        _summaries = _savingsTransactions
            .GroupBy(t => t.Currency)
            .Select(g => new CurrencySummary(
                g.Key,
                g.Count(),
                g.Sum(x => x.Amount)
            ))
            .ToList();

        var minDate = _savingsTransactions.Min(t => t.Date);
        var maxDate = _savingsTransactions.Max(t => t.Date);
        _dateRangeText = $"{minDate:dd.MM.yyyy} – {maxDate:dd.MM.yyyy}";

        _charts = _savingsTransactions
            .GroupBy(t => t.Currency)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    var points = g.GroupBy(t => t.Date.Date)
                        .OrderBy(x => x.Key)
                        .Select(x => new
                        {
                            Date = x.Key,
                            Label = x.Key.ToString("dd.MM"),
                            DailyTotal = (double)x.Sum(t => t.Amount)
                        })
                        .ToList();

                    double runningTotal = 0;
                    var cumulativePoints = points.Select(p =>
                    {
                        runningTotal += p.DailyTotal;
                        return new
                        {
                            p.Label,
                            Total = runningTotal
                        };
                    }).ToList();

                    var labels = cumulativePoints.Select(p => p.Label).ToArray();
                    var data = cumulativePoints.Select(p => p.Total).ToArray();

                    return new ChartData(labels, new List<ChartSeries>
                    {
                        new ChartSeries
                        {
                            Name = g.Key.ToString(),
                            Data = data
                        }
                    });
                });
    }

    #endregion
    
    #region Renders
    
    RenderFragment ParamsContent => (_setParamsSucceeded && !_reportCreated) ?
        @<MudPaper Class="p-3">
            
            <MudForm Model="_reportParams" @ref="@currencyForm"
                     Validation="@_reportParamsValidator.ValidateValue" ValidationDelay="0">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                        <MudSelect Value="_type" Variant="Variant.Outlined" ValueChanged="OnReportChanged" Label="Select Report Type" T="ReportType">
                            <MudSelectItem Value="ReportType.PaymentsReport">Payments Report</MudSelectItem>
                            <MudSelectItem Value="ReportType.BalancesReport">Balances Report</MudSelectItem>
                            <MudSelectItem Value="ReportType.SavingsReport">Savings Report</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (_type == ReportType.PaymentsReport || _type == ReportType.BalancesReport)
                    {
                        <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                            <MudSelect T="string"
                                       Label="Currency Accounts"
                                       Variant="Variant.Outlined"
                                       MultiSelection="true"
                                       SelectAll="true"
                                       SelectAllText="Select all currency accounts"
                                       @bind-Value="_reportParams.NameCollection"
                                       SelectedValues="_reportParams.Names"
                                       SelectedValuesChanged="OnCurrencyNamesChanged"
                                       For="@(() => _reportParams.NameCollection)">
                                @foreach (var dto in _currencyAccountsMetadata.CurrencyAccountMetadataDtos)
                                {
                                    <MudSelectItem T="string" Value="@dto.Name">@dto.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                            <MudSelect T="string"
                                       Label="Currencies"
                                       Variant="Variant.Outlined"
                                       MultiSelection="true"
                                       SelectAll="true"
                                       SelectAllText="Select all currencies"
                                       @bind-Value="_reportParams.CurrencyCollection"
                                       @bind-SelectedValues="_reportParams.Currencies"
                                       For="@(() => _reportParams.CurrencyCollection)">
                                @foreach (var currency in Enum.GetValues<CurrencyDto>())
                                {
                                    <MudSelectItem T="string" Value="@currency.ToString()">@currency</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    @if (_type == ReportType.SavingsReport)
                    {
                        <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                            <MudSelect T="string"
                                       Label="Savings Accounts"
                                       Variant="Variant.Outlined"
                                       MultiSelection="true"
                                       SelectAll="true"
                                       SelectAllText="Select all savings accounts"
                                       @bind-Value="_reportParams.NameCollection"
                                       SelectedValues="_reportParams.Names"
                                       SelectedValuesChanged="OnSavingsNamesChanged"
                                       For="@(() => _reportParams.NameCollection)">
                                @foreach (var dto in _savingsAccountsMetadata.MetadataDtos)
                                {
                                    <MudSelectItem T="string" Value="@dto.Name">@dto.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                        <MudSwitch
                            @bind-Value="_reportParams.AllTime"
                            ThumbIcon="@(_reportParams.AllTime ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
                            ThumbIconColor="@(_reportParams.AllTime ? Color.Success : Color.Error)">All Time</MudSwitch>
                    </MudItem>
                    @if (!_reportParams.AllTime)
                    {
                        <MudItem xs="12" sm="6" md="6" lg="4" xl="2">
                            <MudDatePicker @bind-Date="_reportParams.From"
                                           For="@(() => _reportParams.From)"
                                           Label="Transactions From"
                                           Editable="true"
                                           Mask="@(new DateMask("dd.MM.yyyy"))"
                                           DateFormat="dd.MM.yyyy"
                                           Placeholder="dd.MM.yyyy"
                                           MaxDate="DateTime.UtcNow.AddDays(-1)"
                                           MinDate="_earliestCurrencyCreatedAt"/>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6" lg="4" xl="2">

                            <MudDatePicker @bind-Date="_reportParams.To"
                                           For="@(() => _reportParams.To)"
                                           Label="Transactions To"
                                           Editable="true"
                                           Mask="@(new DateMask("dd.MM.yyyy"))"
                                           DateFormat="dd.MM.yyyy"
                                           Placeholder="dd.MM.yyyy"
                                           MaxDate="DateTime.UtcNow"
                                           MinDate="_reportParams.From"/>
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>

            <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.Send" Color="Color.Primary" OnClick="GetReport">Send</MudButton>
        </MudPaper>
    : null;
    
    RenderFragment PaymentsReportContent => (_reportRequestSucceded && !_noData && _type == ReportType.PaymentsReport)
        ? @<MudGrid>
              <MudItem xs="12">
                  <MudText Typo="Typo.h3" Class="p-2">Payments Report</MudText>
                  <MudStack Row="true" Spacing="2" Class="flex-wrap">
                      <MudPaper Class="p-3 rounded-xl">
                          <MudText Typo="Typo.subtitle2">Total number of expenses</MudText>
                          <MudText Typo="Typo.h6">@_totalCount</MudText>
                      </MudPaper>
                      @foreach (var summary in _summaries)
                      {
                          <MudPaper Class="p-3 rounded-xl">
                              <MudText Typo="Typo.subtitle2">Expenses total — @summary.currency</MudText>
                              <MudText Typo="Typo.h6">@summary.Total.ToString("0.00")</MudText>
                              <MudText Typo="Typo.caption">Transactions: @summary.Count</MudText>
                          </MudPaper>
                      }
                      <MudPaper Class="p-3 rounded-xl">
                          <MudText Typo="Typo.subtitle2">Period</MudText>
                          <MudText Typo="Typo.h6">@_dateRangeText</MudText>
                      </MudPaper>
                  </MudStack>
              </MudItem>
              @foreach (var (currency, chart) in _charts)
              {
                  <MudItem xs="12" md="6" lg="4">
                      <MudCard Class="h-full">
                          <MudCardHeader>
                              <MudText Typo="Typo.h6">@currency — expenses over time</MudText>
                          </MudCardHeader>
                          <MudCardContent>
                              <MudChart ChartType="ChartType.Line"
                                        XAxisLabels="chart.Labels"
                                        Width="100%"
                                        AxisChartOptions="_axisChartOptions"
                                        ChartSeries="chart.Series"
                                        Height="260"/>
                          </MudCardContent>
                      </MudCard>
                  </MudItem>
              }
              <MudItem xs="12">
                  <MudCard>
                      <MudCardHeader>
                          <MudText Typo="Typo.h6">Expense details</MudText>
                      </MudCardHeader>
                      <MudCardContent>
                          <MudTable Items="_payments" Hover="true" Dense="true">
                              <HeaderContent>
                                  <MudTh>Date</MudTh>
                                  <MudTh>Currency</MudTh>
                                  <MudTh align="right">Amount</MudTh>
                                  <MudTh>Category</MudTh>
                              </HeaderContent>
                              <RowTemplate>
                                  <MudTd DataLabel="Date">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                                  <MudTd DataLabel="Currency">@context.Currency</MudTd>
                                  <MudTd DataLabel="Amount" Align="Align.Right">
                                      @Math.Abs(context.Amount).ToString("0.00")
                                  </MudTd>
                                  <MudTd DataLabel="Category">@context.Category</MudTd>
                              </RowTemplate>
                          </MudTable>
                      </MudCardContent>
                  </MudCard>
              </MudItem>
          </MudGrid>
        : null;

    RenderFragment BalancesReportContent => (_reportRequestSucceded && !_noData && _type == ReportType.BalancesReport)
        ? @<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h3" Class="p-2">Balances Report</MudText>
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudPaper Class="p-3 rounded-xl">
                <MudText Typo="Typo.subtitle2">Total transactions</MudText>
                <MudText Typo="Typo.h6">@_totalCount</MudText>
            </MudPaper>
            @foreach (var summary in _summaries)
            {
                <MudPaper Class="p-3 rounded-xl">
                    <MudText Typo="Typo.subtitle2">Net Total — @summary.currency</MudText>
                    <MudText Typo="Typo.h6">@summary.Total.ToString("0.00")</MudText>
                    <MudText Typo="Typo.caption">Transactions: @summary.Count</MudText>
                </MudPaper>
            }
            <MudPaper Class="p-3 rounded-xl">
                <MudText Typo="Typo.subtitle2">Period</MudText>
                <MudText Typo="Typo.h6">@_dateRangeText</MudText>
            </MudPaper>
        </MudStack>
    </MudItem>
    @foreach (var (currency, chart) in _charts)
    {
        <MudItem xs="12" md="6" lg="4">
            <MudCard Class="h-full">
                <MudCardHeader>
                    <MudText Typo="Typo.h6">@currency — Balance over time</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart ChartType="ChartType.Line"
                              XAxisLabels="chart.Labels"
                              Width="100%"
                              AxisChartOptions="_axisChartOptions"
                              ChartSeries="chart.Series"
                              Height="260"/>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Transaction details</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="_currencyTransactions" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Currency</MudTh>
                        <MudTh align="right">Amount</MudTh>
                        <MudTh>Category</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                        <MudTd DataLabel="Currency">@context.Currency</MudTd>
                        <MudTd DataLabel="Amount" Align="Align.Right">@Math.Abs(context.Amount).ToString("0.00")</MudTd>
                        <MudTd DataLabel="Category">@(context.Category?.ToString() ?? "-")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
        : null;

    RenderFragment SavingsReportContent => (_reportRequestSucceded && !_noData && _type == ReportType.SavingsReport)
        ? @<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h3" Class="p-2">Savings Report</MudText>
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            <MudPaper Class="p-3 rounded-xl">
                <MudText Typo="Typo.subtitle2">Total savings transactions</MudText>
                <MudText Typo="Typo.h6">@_totalCount</MudText>
            </MudPaper>
            @foreach (var summary in _summaries)
            {
                <MudPaper Class="p-3 rounded-xl">
                    <MudText Typo="Typo.subtitle2">Total — @summary.currency</MudText>
                    <MudText Typo="Typo.h6">@summary.Total.ToString("0.00")</MudText>
                    <MudText Typo="Typo.caption">Transactions: @summary.Count</MudText>
                </MudPaper>
            }
            <MudPaper Class="p-3 rounded-xl">
                <MudText Typo="Typo.subtitle2">Period</MudText>
                <MudText Typo="Typo.h6">@_dateRangeText</MudText>
            </MudPaper>
        </MudStack>
    </MudItem>
    @foreach (var (currency, chart) in _charts)
    {
        <MudItem xs="12" md="6" lg="4">
            <MudCard Class="h-full">
                <MudCardHeader>
                    <MudText Typo="Typo.h6">@currency — savings over time</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudChart ChartType="ChartType.Line"
                              XAxisLabels="chart.Labels"
                              Width="100%"
                              AxisChartOptions="_axisChartOptions"
                              ChartSeries="chart.Series"
                              Height="260"/>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
    <MudItem xs="12">
        <MudCard>
            <MudCardHeader>
                <MudText Typo="Typo.h6">Savings transaction details</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Items="_savingsTransactions" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Currency</MudTh>
                        <MudTh align="right">Amount</MudTh>
                        <MudTh>Transaction Type</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                        <MudTd DataLabel="Currency">@context.Currency</MudTd>
                        <MudTd DataLabel="Amount" Align="Align.Right">@context.Amount.ToString("0.00")</MudTd>
                        <MudTd DataLabel="Transaction Type">@context.TransactionType</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
        : null;
    
    
    RenderFragment ReturnButton => _reportCreated
        ? @<MudPaper Class="p-3">
              <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardReturn" Color="Color.Primary" OnClick="Return">Return</MudButton>
          </MudPaper>
        : null;
 
    #endregion
    
    
    private async Task OnReportChanged(ReportType newType)
    {
        _type = newType;
    }
    
    private void OnSavingsNamesChanged(IEnumerable<string> names)
    {
        _reportParams.Names = names?.ToList() ?? new List<string>();
        
        var earliest = _savingsAccountsMetadata.MetadataDtos
            .Where(m => _reportParams.Names.Contains(m.Name))
            .Select(m => m.CreatedAt)
            .OrderBy(d => d)
            .FirstOrDefault();

        _earliestCurrencyCreatedAt = earliest;
    }
    
    private void OnCurrencyNamesChanged(IEnumerable<string> names)
    {
        _reportParams.Names = names?.ToList() ?? new List<string>();
        
        var earliest = _currencyAccountsMetadata.CurrencyAccountMetadataDtos
            .Where(m => _reportParams.Names.Contains(m.Name))
            .Select(m => m.CreatedAt)
            .OrderBy(d => d)
            .FirstOrDefault();

        _earliestCurrencyCreatedAt = earliest;
    }
    
    
    private enum ReportType
    {
        PaymentsReport = 1,
        BalancesReport = 2,
        SavingsReport = 3
    }
    
    private class ReportParams 
    {
        public bool AllTime { get; set; }
        public DateTime? From { get; set; }
        public DateTime? To { get; set; }
        
        public string CurrencyCollection { get; set; } // Helper for Multiselect validation
        public IEnumerable<string> Currencies { get; set; }      
        
        public string NameCollection { get; set; } // Helper for Multiselect validation
        public IEnumerable<string> Names { get; set; }
    }
    
    
    private class ReportParamsValidator : AbstractValidator<ReportParams>
    {
        private readonly Func<DateTime> _getEarliest;
        
        public ReportParamsValidator(Func<DateTime> getEarliest)
        {
            _getEarliest = getEarliest;
            RuleFor(x => x.Currencies)
                .NotEmpty()
                .WithMessage("Choose at least one currency");

            RuleFor(x => x.Names)
                .NotEmpty()
                .WithMessage("Choose at least one Currency Account");
                
            
            When(x => !x.AllTime, () =>
            {
                RuleFor(x => x.From)
                    .NotNull()
                    .WithMessage("From date is required when 'AllTime' is false.")
                    .GreaterThanOrEqualTo(_ =>_getEarliest() )
                    .LessThanOrEqualTo(DateTime.UtcNow)
                    .WithMessage("From date cannot be in the future.");

                RuleFor(x => x.To)
                    .NotNull()
                    .WithMessage("To date is required when 'AllTime' is false.")
                    .GreaterThan(x => x.From)
                    .WithMessage("To date must be later than From date.")
                    .LessThanOrEqualTo(DateTime.UtcNow)
                    .WithMessage("To date cannot be in the future.");
            });
        }
        
        public Func<object, string, Task<IEnumerable<string>>> ValidateValue => async (model, propertyName) =>
        {        
            propertyName = propertyName switch
            {
                nameof(ReportParams.CurrencyCollection) => nameof(ReportParams.Currencies),
                nameof(ReportParams.NameCollection)     => nameof(ReportParams.Names),
                _ => propertyName
            };
            
            var result = await ValidateAsync(ValidationContext<ReportParams>.CreateWithOptions((ReportParams)model, x => x.IncludeProperties(propertyName)));
            if (result.IsValid)
                return Array.Empty<string>();
            return result.Errors.Select(e => e.ErrorMessage);
        };
    }
}