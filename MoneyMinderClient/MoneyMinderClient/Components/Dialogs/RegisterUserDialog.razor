@using MoneyMinderContracts.Requests.Accounts.Validators
@using MoneyMinderContracts.Requests.Accounts
@inject IAccountService AccountService


<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 500px; overflow-y: scroll">
            
            <MudForm Model="_request" @ref="@_form" Validation="@ValidationAdapter.ValidateValue(_validator)" ValidationDelay="0">
                <MudCardContent>
                    <MudTextField @bind-Value="_request.Email"
                                  For="@(() => _request.Email)"
                                  Immediate="true"
                                  Label="Email"/>

                    <MudTextField @bind-Value="_request.Password"
                                  For="@(() => _request.Password)"
                                  Immediate="true"
                                  InputType="InputType.Password"
                                  Label="Password"/>
                    <MudTextField @bind-Value="_request.FirstName"
                                  For="@(() => _request.FirstName)"
                                  Immediate="true"
                                  Label="First Name"/>

                    <MudTextField @bind-Value="_request.LastName"
                                  For="@(() => _request.LastName)"
                                  Immediate="true"
                                  Label="Last Name"/>

                    <MudTextField @bind-Value="_request.PhoneCode"
                                  For="@(() => _request.PhoneCode)"
                                  Immediate="true"
                                  Label="Phone Code"/>

                    <MudTextField @bind-Value="_request.PhoneNumber"
                                  For="@(() => _request.PhoneNumber)"
                                  Immediate="true"
                                  Label="Phone Number"/>

                    <MudSelect @bind-Value="_request.GenderDto"
                               Label="Gender"
                               For="@(() => _request.GenderDto)">
                        <MudSelectItem Value="GenderDto.Men">Men</MudSelectItem>
                        <MudSelectItem Value="GenderDto.Women">Women</MudSelectItem>
                    </MudSelect>

                    <MudDatePicker @bind-Date="_request.BirthDate"
                                   Label="Birth Date"
                                   MaxDate="DateTime.Today.AddYears(-18)"
                                   For="@(() => _request.BirthDate)"/>

                    <MudTextField @bind-Value="_request.Country"
                                  For="@(() => _request.Country)"
                                  Immediate="true"
                                  Label="Country"/>

                    <MudTextField @bind-Value="_request.City"
                                  For="@(() => _request.City)"
                                  Immediate="true"
                                  Label="City"/>
                    
                    <MudTextField @bind-Value="_request.PostalCode"
                                  For="@(() => _request.PostalCode)"
                                  Immediate="true"
                                  Label="Postal Code"/>

                    <MudTextField @bind-Value="_request.Street"
                                  For="@(() => _request.Street)"
                                  Immediate="true"
                                  Label="Street"/>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="RegisterAsync">Register</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="CloseDialog">Cancel</MudButton>
                    </MudCardActions>
                </MudCardContent>
            </MudForm>
        </MudContainer>
    </DialogContent>

</MudDialog>

@code {
    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; }

    MudForm _form = new();
    
    CreateUserRequest _request = new()
    {
        BirthDate = DateTime.UtcNow.AddYears(-18),
        GenderDto = GenderDto.Men
    };

    CreateUserValidator _validator = new();
    

    private void CloseDialog()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
    
    private async Task RegisterAsync()
    {
        await _form.Validate();

        if (_form.IsValid)
        {
            var isSucces = await AccountService.RegisterAsync(_request);
            
            MudDialog.Close(DialogResult.Ok(isSucces));
        }
    }
    
}